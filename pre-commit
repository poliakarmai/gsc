#!/bin/sh
# GSC Smart Pre-commit Hook — блокирует только НОВЫЕ Critical находки
# Установка: cp pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit

echo "🔒 GSC pre-commit audit..."

# Ищем GSC
GSC_SCRIPT=""
for dir in "$HOME/gsc" "$(dirname "$0")/../.." "$(dirname "$0")/../../../gsc"; do
    if [ -f "$dir/gsc.py" ]; then GSC_SCRIPT="$dir/gsc.py"; break; fi
done
[ -z "$GSC_SCRIPT" ] && echo "⚠️  GSC not found" && exit 0

# Аргументы — только изменённые файлы, JSON, CI-режим
python3 "$GSC_SCRIPT" scan "$(pwd)" --diff --ci --json > /tmp/gsc_hook_result.json 2>/dev/null

# Считаем новые CRITICAL (те, что не в baseline)
CRITICAL=$(python3 -c "
import json, os
try:
    findings = json.load(open('/tmp/gsc_hook_result.json'))
except: findings = []

# Try to load baseline
baseline_path = '.gsc/baseline.json'
baseline_hashes = set()
if os.path.exists(baseline_path):
    baseline = json.load(open(baseline_path))
    baseline_hashes = {f['hash'] for f in baseline.get('findings', [])}

new_critical = []
for f in findings:
    if f.get('category') == 'CRITICAL':
        # Check if in baseline
        import hashlib
        h = hashlib.sha256(f\"{f['file_path']}:{f['line_number']}:{f['title']}\".encode()).hexdigest()[:12]
        if h not in baseline_hashes:
            new_critical.append(f)

print(len(new_critical))
for f in new_critical[:5]:
    print(f'  [{f[\"category\"]}] {f[\"title\"][:70]} — {f[\"file_path\"]}:{f[\"line_number\"]}')
if len(new_critical) > 5:
    print(f'  ... and {len(new_critical)-5} more')
" 2>/dev/null)

if [ "$CRITICAL" -gt 0 ] 2>/dev/null; then
    echo ""
    echo "🔴 GSC found $CRITICAL NEW critical findings!"
    echo "   Run 'gsc triage' to review, or 'git commit --no-verify' to skip."
    python3 -c "
import json, hashlib, os
findings = json.load(open('/tmp/gsc_hook_result.json'))
baseline_path = '.gsc/baseline.json'
baseline_hashes = set()
if os.path.exists(baseline_path):
    baseline = json.load(open(baseline_path))
    baseline_hashes = {f['hash'] for f in baseline.get('findings', [])}
for f in findings:
    if f.get('category') == 'CRITICAL':
        h = hashlib.sha256(f'{f[\"file_path\"]}:{f[\"line_number\"]}:{f[\"title\"]}'.encode()).hexdigest()[:12]
        if h not in baseline_hashes:
            print(f'  [{f[\"category\"]}] {f[\"title\"]} — {f[\"file_path\"]}:{f[\"line_number\"]}')
" 2>/dev/null
    exit 1
fi

echo "  ✅ No new critical findings"
exit 0
