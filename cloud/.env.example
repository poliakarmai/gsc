# GSC Cloud 1.0 environment variables
# Copy to .env and fill in

# PostgreSQL
PG_PASSWORD=changeme
# gsc_app role password — MUST match the password inside GSC_DATABASE_URL.
# Injected into cloud/bootstrap_roles.sql (CREATE/ALTER ROLE gsc_app).
GSC_APP_PASSWORD=changeme
GSC_DATABASE_URL=postgresql://gsc_app:changeme@postgres:5432/gsc

# Redis (requirepass enforced — generate password: openssl rand -hex 16)
GSC_REDIS_PASSWORD=changeme
GSC_REDIS_URL=redis://:changeme@redis:6379/0

# Session signing secret (generate: openssl rand -hex 32)
GSC_SESSION_SECRET=changeme-32bytes-minimum!!

# GitHub OAuth (S3)
GSC_OAUTH_CLIENT_ID=
GSC_OAUTH_CLIENT_SECRET=
GSC_OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/github/callback

# Stripe (S3)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# GitHub App (S2)
GSC_GITHUB_APP_ID=
GSC_GITHUB_APP_PRIVATE_KEY=
GSC_GITHUB_WEBHOOK_SECRET=

# GitHub Marketplace (S4)
GSC_MARKETPLACE_SECRET=

# SSO redirect (S4)
GSC_SSO_REDIRECT_URI=http://localhost:3000/api/auth/sso/callback

# DeepSeek (LLM)
DEEPSEEK_API_KEY=