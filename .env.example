# ============================================================================
# GSC (Git Security Checker) — переменные окружения
# Скопируйте в `.env` и заполните реальными значениями. НЕ коммитьте `.env`.
# ============================================================================

# ── LLM (revalidate / judge / deep-reducer) ────────────────────────────────
# Отсутствие ключа → авто-деградация на regex-only (без LLM)
DEEPSEEK_API_KEY=

# ── Ядро / БД ──────────────────────────────────────────────────────────────
# SQLite (по умолчанию):
GSC_DB=~/.hermes/state/gsc_audit.db
GSC_DATA_DIR=
# PostgreSQL (cloud-режим, приоритетнее SQLite):
GSC_DATABASE_URL=
GSC_REDIS_URL=redis://localhost:6379/0
GSC_AUDIT_DB=

# ── Сессии / JWT ───────────────────────────────────────────────────────────
GSC_SESSION_SECRET=
JWT_SECRET=
GSC_DEV_MODE=0
GSC_INVITE_ONLY=1

# ── OAuth / SSO ────────────────────────────────────────────────────────────
GSC_OAUTH_CLIENT_ID=
GSC_OAUTH_CLIENT_SECRET=
GSC_OAUTH_REDIRECT_URI=
GSC_SSO_REDIRECT_URI=http://localhost:3000/api/auth/sso/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8081/api/v2/auth/github/callback

# ── Stripe (billing) ───────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_PRICE_TEAM=
STRIPE_PRICE_BUSINESS=
STRIPE_WEBHOOK_SECRET=

# ── GitHub App / marketplace / MCP ─────────────────────────────────────────
GSC_APP_ID=
GSC_APP_PRIVATE_KEY=
GSC_WEBHOOK_SECRET=
GSC_MARKETPLACE_SECRET=
GSC_API_KEY=
GSC_MCP_TOKEN=
GSC_MCP_TENANT=

# ── Политики ───────────────────────────────────────────────────────────────
GSC_ALLOWED_GIT_HOSTS=github.com,gitlab.com
GSC_DASHBOARD_URL=http://localhost:3000
