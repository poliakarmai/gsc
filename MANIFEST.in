# Audit A-01: don't ship build/dist/generated database artifacts in sdist
prune build
prune dist
prune OWASPBenchmark
prune HuixiangDou
prune gsc-vscode
prune benchmark
prune calibration
prune example_projects
global-exclude *.db *.sqlite *.sqlite3 *.pkl *.whl *.vsix *.tar.gz *.pyc *.pyo
global-exclude .repowise .DS_Store
